# Keep credentials out of Git. The VITE_ values are browser-visible and must only be public keys.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Server only: do not rename with VITE_ or expose to frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-secret
PORT=3001
